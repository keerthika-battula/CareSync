# =============================================
# CareSync Environment Configuration
# Copy this file to .env and fill in values
# =============================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caresync_db
DB_USER=caresync_user
DB_PASSWORD=your_secure_db_password_here

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT (use a strong Base64-encoded secret, min 256 bits)
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRY=86400000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=caresync-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Firebase
FIREBASE_CREDENTIALS_PATH=path/to/firebase-service-account.json

# Caresync
REFILL_DEFAULT_THRESHOLD_DAYS=7
