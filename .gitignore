# Root .gitignore for CareSync project
# ==============================
# Environment files
.env
.env.*
!.env.example
*.env

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/
log/
backend/*.log

# Docker
docker-compose.override.yml

# IDEs and editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
out/

# Secrets, certificates, and credentials
firebase-service-account.json
**/firebase-service-account*.json
**/google-services.json
**/GoogleService-Info.plist
*.pem
*.key
*.p12
*.jks

# Build artifacts
# Backend (Maven & Java Spring Boot)
target/
**/target/
backend/target/
*.jar
*.war
.flattened-pom.xml

# Frontend (Node.js / React / Vite)
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
*.tsbuildinfo

# Misc temporary files
*.tmp
*.swp
*~
